{
  "ci": {
    "collect": {
      "staticDistDir": "conformance/public/ours",
      "url": [
        "http://localhost/index.html",
        "http://localhost/kitchen-sink/index.html",
        "http://localhost/kitchen-sink/links/index.html",
        "http://localhost/kitchen-sink/long/index.html"
      ],
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1
          }
        ],
        "resource-summary:total:size": [
          "error",
          {
            "maxNumericValue": 307200
          }
        ],
        "third-party-summary": [
          "error",
          {
            "maxLength": 0
          }
        ]
      }
    }
  }
}
