conformance/config/scale/

# What a full run leaves behind. htmltest caches its results under tmp/,
# lighthouse-ci writes its reports, and python writes bytecode. None of
# it is the theme, and git add -A would take all of it.
tmp/
.lighthouseci/
__pycache__/
*.pyc

# Playwright, when somebody points it here. The browsers are hundreds
# of megabytes, and a bootstrap run commits whatever it finds.
.playwright/

# stylelint resolves its shared config from the repository, so it may
# have to be installed here rather than globally. That leaves thirty
# megabytes at the root, which is the same hazard as the browsers.
node_modules/
